[Unit]
Description=Foverin autonomous system optimizer (eBPF + memory policy + actuator)
Documentation=file:///usr/local/share/doc/foverin/README.md
After=multi-user.target

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/foverin-daemon
Restart=always
RestartSec=2
# Persist episodic memory across restarts (adjust path after install).
Environment=FOVERIN_MEMORY=/var/lib/foverin/foverin_memory.json
# Logs go to the journal; Matrix UI is a separate unprivileged client.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
