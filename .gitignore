### https://raw.github.com/github/gitignore/master/Rust.gitignore

# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
# Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these
*.pdb

# ---------------------------------------------------------------------------
# Foverin / BPF / local runtime
# ---------------------------------------------------------------------------

# Unix domain sockets
*.sock
/tmp/foverin.sock

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS junk
.DS_Store
Thumbs.db

# Local agent / session memory (not for public tree)
memories.md

# Runtime episodic policy store (generated by the daemon)
foverin_memory.json

# Legacy Candle weight dumps (removed in v0.2.0)
foverin_weights.safetensors
*.safetensors

# Env / secrets
.env
.env.*
!.env.example

# Coverage / profiling
*.profraw
*.profdata
coverage/
lcov.info

# bpf-linker / clang intermediates occasionally left behind
*.o
*.bc
/foverin-ebpf/target/
